# Load these into your shell; TextVBench does not automatically read .env files.
# Use EMPTY only for a local endpoint that does not require authentication.
TEXTVBENCH_VLM_BASE_URL=http://127.0.0.1:8000/v1
TEXTVBENCH_VLM_MODEL=your-vision-language-model
TEXTVBENCH_VLM_API_KEY=EMPTY
TEXTVBENCH_VLM_PROFILE=local-vlm
